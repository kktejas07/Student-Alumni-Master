# Student Alumni Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# NEVER commit .env to version control. It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas recommended)
# Local:      mongodb://localhost:27017
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=studentalumni

# JWT signing secret (32+ random characters)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-secrets-token-hex-32

# Fernet key for encrypting PII at rest (REQUIRED in production)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── CORS & URLs ──────────────────────────────────────────────────────────────

# Comma-separated allowed origins (no trailing slashes, no spaces)
# Dev:  http://localhost:8081,http://localhost:3000
# Prod: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Public URL of the frontend (used for CORS fallback and email links)
FRONTEND_URL=http://localhost:8081

# ── Admin Seed Account ───────────────────────────────────────────────────────

# Seeded on first startup. Change these after your first login.
ADMIN_EMAIL=admin@studentalumni.ai
ADMIN_PASSWORD=admin123

# ── Server ───────────────────────────────────────────────────────────────────

# Number of uvicorn workers (1 for dev, 2-4 for prod)
UVICORN_WORKERS=1

# ── SMTP (for forgot-password / OTP emails) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=noreply@studentalumni.ai

# ── AI / LLM (optional — comment out unused ones) ────────────────────────────

# LiteLLM / OpenAI-compatible endpoint
# OPENAI_API_KEY=sk-...
# LITELLM_MODEL=gpt-4o-mini

# Google Gemini
# GOOGLE_API_KEY=AIza...

# Groq (fast inference)
# GROQ_API_KEY=gsk_...

# ── Payments (optional) ───────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloud Storage (optional) ──────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=...
# AWS_REGION=ap-south-1

# ── External APIs (optional) ──────────────────────────────────────────────────
# ADZUNA_APP_ID=...
# ADZUNA_API_KEY=...
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...

# ── Environment ───────────────────────────────────────────────────────────────
# ENV=development   # or "production"
