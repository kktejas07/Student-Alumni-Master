# =============================================================================
# Student Alumni Platform — Backend Environment Variables Template
# =============================================================================
# Copy this file to backend/.env and update the values for your environment.
# =============================================================================

# ─── Required Database & Auth ────────────────────────────────────────────────
# MongoDB connection URL (use localhost or 127.0.0.1 for local MongoDB instance)
MONGO_URL=mongodb://localhost:27017/student_alumni
DB_NAME=student_alumni

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=3f8c9d2a4e6b1a5d7e9f8c3b2a1d4e6f9c8b7a3d2e1f4c6b8a9d7e2f3c5b1a4d

# Fernet Key for PII encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=6Ro4BSxt3IewUMXbIgzVX1zacg_E5PWL-uyinzgD_dI=

# Admin bootstrap credentials
ADMIN_EMAIL=admin@studentalumni.ai
ADMIN_PASSWORD=Admin@12345

# ─── Server & Network Configuration ──────────────────────────────────────────
ENV=development
PORT=8002
BACKEND_URL=http://localhost:8002
FRONTEND_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8002
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ─── Background Jobs & Schedulers ────────────────────────────────────────────
# Set to 0 to disable distributed leader lock during local single-instance dev
SCHEDULER_LEADER_LOCK=0
SCHEDULER_LEASE_TTL=90

# ─── Optional Integrations ───────────────────────────────────────────────────
# Emergent LLM key (for AI career guidance features)
EMERGENT_LLM_KEY=sk-emergent-7E24f455a46171073C

# Virus scanning (leave empty to disable ClamAV requirement in local dev)
CLAMAV_HOST=
CLAMAV_PORT=3310

# Transactional Email (Postal) - leave empty for mock / fallback
POSTAL_API_URL=
POSTAL_SERVER_API_KEY=
POSTAL_FROM_EMAIL=Student Alumni <noreply@studentalumni.ai>

