{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Enterprise-Grade Playwright Test Automation Framework",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:student": "playwright test tests/Student",
    "test:mentor": "playwright test tests/Mentor",
    "test:alumni": "playwright test tests/Alumni",
    "test:college": "playwright test tests/College",
    "test:echo": "playwright test tests/echo-showcase-cms.spec.ts --project=chromium",
    "report:html": "playwright show-report reports/html",
    "report:allure": "allure generate allure-results --clean -o reports/allure-report"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@faker-js/faker": "^9.5.0",
    "axios": "^1.8.1",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.2.0",
    "typescript": "^5.7.3"
  }
}