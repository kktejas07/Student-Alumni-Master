{
  "expo": {
    "name": "Career Path",
    "slug": "frontend",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/sa-icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careerpath.app",
      "buildNumber": "19",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture your profile photo for your unique student ID.",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo for your student ID."
      }
    },
    "android": {
      "package": "com.careerpath.app",
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sa-adaptive-icon.png",
        "backgroundColor": "#0a0f1e"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/sa-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sa-splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0f1e"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Capture your profile photo for your unique student ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo for your student ID."
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
