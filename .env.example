# =============================================================================
# Student Alumni Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas recommended for production)
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name
DB_NAME=studentalumniadmin

# JWT signing secret — MUST be 32+ random characters
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-32-char-random-string

# Fernet encryption key for PII at rest — REQUIRED in production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=Fernet-key-generated-via-python

# ─── CORS & URLs ──────────────────────────────────────────────────────────────

# Allowed origins (comma-separated, no spaces). Must be exact domains.
# In production, NEVER use "*" — list explicit domains.
ALLOWED_ORIGINS=https://studentalumni.ai,https://www.studentalumni.ai

# Frontend URL (used for CORS fallback and links)
FRONTEND_URL=https://studentalumni.ai

# ─── Admin Seed ────────────────────────────────────────────────────────────────

# Initial admin account credentials (change after first login)
ADMIN_EMAIL=admin@studentalumni.ai
ADMIN_PASSWORD=ChangeMeInProduction!

# ─── Server Config ─────────────────────────────────────────────────────────────

# Number of uvicorn workers (2-4 recommended)
UVICORN_WORKERS=2

# ─── Optional Integrations ─────────────────────────────────────────────────────

# Emergent LLM key (for Agent K AI features)
# EMERGENT_LLM_KEY=

# ─── Email Delivery (Postal — postalserver.io) ───────────────────────────────
# The platform's primary transactional email provider. When unset, the backend
# falls back to any SendGrid / Gmail integration configured in the admin
# marketplace (installed_tools).
#
# POSTAL_API_URL — your Postal server origin, e.g. https://mail.example.com
# POSTAL_SERVER_API_KEY — server API key (Postal → Settings → API Keys)
# POSTAL_FROM_EMAIL — verified sender, e.g. Student Alumni <noreply@yourdomain.com>
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=Student Alumni <noreply@studentalumni.ai>

# ─── Environment ──────────────────────────────────────────────────────────────

# Set to "production" for production deployments
# ENV=development