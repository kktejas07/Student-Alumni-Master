# ─── Optional Integrations ─────────────────────────────────────────────────────

# Emergent LLM key (for Agent K AI features)
# EMERGENT_LLM_KEY=

# ─── Email Delivery (Postal — postalserver.io) ───────────────────────────────
# The platform's primary transactional email provider. When unset, the backend
# falls back to any SendGrid / Gmail integration configured in the admin
# marketplace (installed_tools).
#
# POSTAL_API_URL — your Postal server origin, e.g. https://mail.example.com
# POSTAL_SERVER_API_KEY — server API key (Postal → Settings → API Keys)
# POSTAL_FROM_EMAIL — verified sender, e.g. Student Alumni <noreply@yourdomain.com>
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=Student Alumni <noreply@studentalumni.ai>

# ─── Environment ──────────────────────────────────────────────────────────────

# Set to "production" for production deployments
# ENV=development
# ── Background jobs ────────────────────────────────────────────────────────
# Only one worker runs schedulers (crons, payment sweep, newsletter sends,
# agent loops). Leadership is a Mongo lease; set to 0 for single-process dev.
# SCHEDULER_LEADER_LOCK=1
# SCHEDULER_LEASE_TTL=90

# ── Website contact form ──────────────────────────────────────────────────
# Inbox that receives POST /api/contact inquiries.
# CONTACT_INBOX=hr@studentalumni.ai

# ── Course Aggregator Bot (C1) ─────────────────────────────────────────────
# 24h refresh of the external_courses collection (21 free-course sources).
# Optional API keys unlock live listings; without them, the adapters fall
# back to deterministic static catalogs.
# YOUTUBE_API_KEY=
# UDEMY_API_KEY=

# 0 to disable the daily 02:00 UTC cron (default 1).
# AGGREGATOR_CRON_ENABLED=1
# 0 to skip the startup catch-up run when the last run is >24h old (default 1).
# AGGREGATOR_RUN_ON_STARTUP=1
