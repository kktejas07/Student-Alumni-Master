{
  "theme": "Dark",
  "archetype": "FinTax360 — Jewel & Luxury Glassmorphism",
  "scope": "Student Portal only. Alumni/College/Mentor/Super-Admin retain their own palettes.",
  "design_philosophy": {
    "core_principles": [
      "Glassmorphism dark theme with animated multicolor aurora background.",
      "Premium, trustworthy, high-tech and modern — data-rich but breathable.",
      "Every card is a frosted-glass surface (22px backdrop blur, 180% saturate).",
      "Neutral white hairlines (white/8) on glass; violet hairline only on hover/focus.",
      "Typography is intentional: Outfit (display), Plus Jakarta Sans (body), JetBrains Mono (numerics)."
    ],
    "emotion": "Premium, calm, trustworthy, modern",
    "target_audience": "Students seeking a polished career-management dashboard"
  },
  "colors": {
    "background": {
      "gradient_from": "#0a0f1e",
      "gradient_to":   "#131938",
      "solid_canvas":  "#0a0f1e"
    },
    "surface": {
      "glass":         "rgba(20, 26, 45, 0.55)",
      "glass_strong":  "rgba(20, 26, 45, 0.72)",
      "glass_soft":    "rgba(255, 255, 255, 0.04)"
    },
    "border": {
      "default":       "rgba(255, 255, 255, 0.08)",
      "hover":         "rgba(139, 92, 246, 0.40)",
      "highlight":     "rgba(255, 255, 255, 0.10)"
    },
    "brand": {
      "primary":       "#8B5CF6",
      "primary_deep":  "#7C3AED",
      "primary_soft":  "#A78BFA",
      "primary_glow":  "rgba(139, 92, 246, 0.5)"
    },
    "accents": {
      "blue":          "#3B82F6",
      "teal":          "#10B981",
      "amber":         "#F59E0B",
      "rose":          "#f43f5e"
    },
    "text": {
      "primary":       "#FFFFFF",
      "secondary":     "rgba(255, 255, 255, 0.70)",
      "muted":         "rgba(255, 255, 255, 0.50)"
    },
    "status": {
      "success_bg": "rgba(16,185,129,0.10)", "success_fg": "#34D399", "success_bd": "rgba(16,185,129,0.20)",
      "warning_bg": "rgba(245,158,11,0.10)", "warning_fg": "#FBBF24", "warning_bd": "rgba(245,158,11,0.20)",
      "danger_bg":  "rgba(239,68,68,0.10)",  "danger_fg":  "#F87171", "danger_bd":  "rgba(239,68,68,0.20)",
      "neutral_bg": "rgba(255,255,255,0.05)", "neutral_fg": "rgba(255,255,255,0.70)", "neutral_bd": "rgba(255,255,255,0.10)"
    }
  },
  "typography": {
    "font_families": {
      "display":  "Outfit",
      "body":     "Plus Jakarta Sans",
      "monospace":"JetBrains Mono"
    },
    "expo_packages": [
      "@expo-google-fonts/outfit",
      "@expo-google-fonts/plus-jakarta-sans",
      "@expo-google-fonts/jetbrains-mono"
    ],
    "scales": {
      "h0":         { "fontSize": 56, "lineHeight": 60, "fontFamily": "Outfit_800ExtraBold", "letterSpacing": -1.5 },
      "h1":         { "fontSize": 40, "lineHeight": 44, "fontFamily": "Outfit_800ExtraBold", "letterSpacing": -1.0 },
      "h2":         { "fontSize": 28, "lineHeight": 32, "fontFamily": "Outfit_700Bold",      "letterSpacing": -0.5 },
      "h3":         { "fontSize": 20, "lineHeight": 24, "fontFamily": "Outfit_700Bold" },
      "body_lg":    { "fontSize": 16, "lineHeight": 24, "fontFamily": "PlusJakartaSans_500Medium" },
      "body":       { "fontSize": 14, "lineHeight": 20, "fontFamily": "PlusJakartaSans_500Medium" },
      "caption":    { "fontSize": 12, "lineHeight": 16, "fontFamily": "PlusJakartaSans_500Medium" },
      "kpi":        { "fontSize": 32, "lineHeight": 36, "fontFamily": "JetBrainsMono_600SemiBold", "letterSpacing": -1 },
      "kicker":     { "fontSize": 11, "lineHeight": 14, "fontFamily": "PlusJakartaSans_600SemiBold", "letterSpacing": 2.4, "textTransform": "uppercase" }
    }
  },
  "layout": {
    "container_padding_clamp": "16 → 32 (responsive by breakpoint)",
    "safe_area": "react-native-safe-area-context",
    "border_radius": { "sm": 8, "md": 12, "lg": 14, "xl": 20, "pill": 9999 },
    "spacing": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
    "grid": {
      "phone":   "1 column",
      "tablet":  "3 columns",
      "desktop": "4 columns"
    }
  },
  "components": {
    "glass_card": {
      "backgroundColor": "rgba(20, 26, 45, 0.55)",
      "backdropBlur_px": 22,
      "backdropSaturate_pct": 180,
      "borderWidth": 1,
      "borderColor": "rgba(255, 255, 255, 0.08)",
      "borderColor_hover": "rgba(139, 92, 246, 0.40)",
      "borderRadius": 14,
      "boxShadow": "0 16px 48px rgba(2,6,23,0.45), 0 1px 0 rgba(255,255,255,0.06) inset",
      "boxShadow_hover": "0 10px 30px rgba(139,92,246,0.35), 0 0 0 1px rgba(139,92,246,0.20)"
    },
    "primary_button": {
      "backgroundColor": "#8B5CF6",
      "backgroundColor_hover": "#A78BFA",
      "borderRadius": 12,
      "paddingX": 24,
      "paddingY": 10,
      "borderWidth": 1,
      "borderColor": "rgba(139, 92, 246, 0.20)",
      "boxShadow": "0 0 20px rgba(139, 92, 246, 0.3)",
      "boxShadow_hover": "0 0 30px rgba(139, 92, 246, 0.6)"
    },
    "sidebar": {
      "width": 256,
      "borderRight": "1px solid rgba(255,255,255,0.08)",
      "backgroundColor": "rgba(10,15,30,0.80)",
      "backdropBlur_px": 24,
      "backdropSaturate_pct": 180
    },
    "topbar": {
      "height": 64,
      "position": "sticky",
      "zIndex": 40,
      "backgroundColor": "rgba(10,15,30,0.80)",
      "backdropBlur_px": 20,
      "backdropSaturate_pct": 180
    },
    "status_chip": {
      "shape": "pill (px-2.5 py-0.5)",
      "borderWidth": 1,
      "fontFamily": "PlusJakartaSans_600SemiBold",
      "fontSize": 11,
      "variants": ["success", "warning", "danger", "neutral"]
    },
    "ai_copilot_fab": {
      "position": "fixed bottom-right",
      "offset": { "bottom": 22, "right": 22 },
      "height": 56,
      "paddingX": 22,
      "borderRadius": 9999,
      "background_gradient": ["#8B5CF6", "#7C3AED"],
      "boxShadow_idle":  "0 12px 32px rgba(139,92,246,0.40), 0 0 0 1px rgba(139,92,246,0.28)",
      "boxShadow_hover": "0 18px 44px rgba(139,92,246,0.55), 0 0 0 1px rgba(139,92,246,0.42)",
      "breathing_glow": { "duration_ms": 3200, "opacity_range": [0.35, 0.75] },
      "visibility": "Every Student screen INCLUDING /agent-k itself"
    }
  },
  "motion": {
    "page_transition":      { "opacity": "0 → 1", "translateY": "10 → 0", "duration_ms": 400, "easing": "easeOut" },
    "card_mount_in":        { "opacity": "0 → 1", "translateY": "8 → 0",  "duration_ms": 350, "easing": "easeOut(cubic)" },
    "card_stagger_ms":      40,
    "hover_lift":           { "translateY": "0 → -3", "duration_ms": 220, "easing": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "press_scale":          { "scale": "1 → 0.99", "duration_ms": 120 },
    "aurora_orb_loop":      { "duration_s": [22, 28, 32], "translate_range_vw_vh": 15 }
  },
  "icons": {
    "library": "lucide-react-native (via iconShims.tsx adapter)",
    "stroke_width": 1.5,
    "default_color": "rgba(255, 255, 255, 0.70)",
    "sizes": { "sm": 12, "md": 18, "lg": 22, "xl": 28 },
    "rules": ["Never use emojis as functional icons.", "Use semantic icons with text labels for accessibility."]
  },
  "primitives_exported_from_glass_tsx": [
    "AnimatedAurora",
    "GridOverlay",
    "GlassCard",
    "GlassSoft",
    "KpiTile",
    "PillChip",
    "GradientButton",
    "AiCopilotFab",
    "RouteTransition",
    "StatusChip",
    "Kicker"
  ],
  "rules_donts": [
    "❌ No solid white cards.",
    "❌ No Shadcn defaults — every component is re-skinned for glass.",
    "❌ No purple-on-white gradients.",
    "❌ No emoji icons.",
    "❌ Do not apply this theme to Alumni, College, Mentor or Super-Admin portals.",
    "❌ Do not hardcode hex values — always import from PALETTE in tokens.ts.",
    "❌ Do not use position: absolute for main content layout."
  ],
  "rules_dos": [
    "✅ Wrap every screen with <RouteTransition>.",
    "✅ Use <GlassCard> for every card-shaped surface.",
    "✅ Use <Kicker> for uppercase eyebrow labels above titles.",
    "✅ Use <StatusChip> with one of 4 tones for state indicators.",
    "✅ Use JetBrains Mono for numerics, KPIs, IDs, hashes.",
    "✅ All interactive elements MUST have testID + accessibilityLabel."
  ],
  "files": {
    "design_tokens":     "frontend/src/views/web/portals/student/tokens.ts",
    "primitives":        "frontend/src/views/web/portals/student/glass.tsx",
    "shell":             "frontend/src/views/web/portals/student/StudentPortalRN.tsx",
    "topbar":            "frontend/src/views/web/portals/student/TopBar.tsx",
    "sidebar":           "frontend/src/views/web/portals/student/Sidebar.tsx",
    "google_fonts_load": "frontend/app/_layout.tsx",
    "markdown_guide":    "docs/STYLE_GUIDE.md"
  },
  "version": "0.19.1",
  "last_updated": "2026-06-15"
}
